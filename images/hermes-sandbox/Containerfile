FROM registry.access.redhat.com/ubi9/python-311:latest

USER 0

RUN dnf install -y --nodocs \
        git nodejs npm \
        nss nspr \
        atk at-spi2-atk \
        cups-libs \
        libdrm \
        libxkbcommon \
        libXcomposite libXdamage libXrandr libXext libXfixes \
        libXi libXtst libXcursor libX11-xcb \
        mesa-libgbm \
        pango cairo \
        alsa-lib \
        dbus-libs \
    && dnf clean all

ARG HERMES_AGENT_VERSION=0.19.0
ARG PLAYWRIGHT_VERSION=1.61.0
RUN pip install --no-cache-dir \
        hermes-agent==${HERMES_AGENT_VERSION} \
        playwright==${PLAYWRIGHT_VERSION}

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN playwright install chromium && \
    chgrp -R 0 /opt/playwright-browsers && \
    chmod -R g=u /opt/playwright-browsers

RUN CHROME_BIN=$(find /opt/playwright-browsers -name "chrome" -o -name "headless_shell" 2>/dev/null | head -1) && \
    echo "Chromium binary: ${CHROME_BIN}" && \
    "${CHROME_BIN}" --version --no-sandbox --headless --disable-gpu 2>&1 || \
    (echo "FATAL: Chromium smoke test failed" && exit 1)

RUN git clone --depth 1 https://github.com/nesquena/hermes-webui.git /opt/hermes-webui && \
    cd /opt/hermes-webui && \
    pip install --no-cache-dir -r requirements.txt 2>/dev/null || true

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

RUN mkdir -p /home/hermes/.hermes /home/hermes/.cache /tmp/hermes && \
    chgrp -R 0 /home/hermes /opt/hermes-webui /tmp/hermes && \
    chmod -R g=u /home/hermes /opt/hermes-webui /tmp/hermes

ENV HOME=/home/hermes \
    HERMES_WEBUI_PORT=8080 \
    HERMES_WEBUI_HOST=0.0.0.0 \
    HERMES_WEBUI_STATE_DIR=/home/hermes/.hermes/webui \
    AGENT_BROWSER_ARGS="--no-sandbox,--disable-dev-shm-usage,--disable-gpu,--disable-setuid-sandbox"

EXPOSE 8080

WORKDIR /opt/hermes-webui

USER 1001

CMD ["/usr/local/bin/entrypoint.sh"]
